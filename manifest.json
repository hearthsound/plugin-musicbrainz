{
  "manifestVersion": 1,
  "id": "app.hearthsound.musicbrainz",
  "name": "MusicBrainz metadata",
  "version": "0.1.0",
  "description": "Resolve recordings and materialize releases from the MusicBrainz web service, without an account or an API key.",
  "authors": ["Hearthsound contributors"],
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/hearthsound/plugin-musicbrainz",
  "api": "hearthsound:plugin@0.1.0",
  "provides": ["metadata"],
  "permissions": {
    "http": {
      "hosts": ["musicbrainz.org", "$config:baseUrl"],
      "rateLimit": { "perSecond": 1, "burst": 1 }
    }
  },
  "config": {
    "server": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "baseUrl": {
            "type": "string",
            "format": "uri",
            "title": "MusicBrainz WS/2 base URL",
            "description": "Base URL of the MusicBrainz web service. Point it at a mirror to keep traffic off musicbrainz.org; a value without a trailing slash gets one.",
            "default": "https://musicbrainz.org/ws/2/"
          }
        }
      },
      "uiSchema": {
        "type": "VerticalLayout",
        "elements": [{ "type": "Control", "scope": "#/properties/baseUrl" }]
      }
    },
    "user": null
  },
  "resources": { "memoryMb": 64, "callTimeoutMs": 30000, "maxInstances": 2 }
}
