{
  "manifestVersion": 1,
  "id": "app.hearthsound.musicbrainz",
  "name": "MusicBrainz metadata",
  "version": "0.5.3",
  "description": "Search, resolve and illustrate music from the MusicBrainz web service, without an account or an API key.",
  "authors": [
    "Hearthsound contributors"
  ],
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/hearthsound/plugin-musicbrainz",
  "api": "hearthsound:plugin@0.5.0",
  "provides": [
    "catalog",
    "metadata",
    "artwork"
  ],
  "permissions": {
    "http": {
      "hosts": [
        {
          "host": "musicbrainz.org",
          "rateLimit": {
            "perSecond": 1,
            "burst": 1
          }
        },
        "coverartarchive.org",
        "archive.org",
        "*.archive.org",
        "www.wikidata.org",
        "*.wikipedia.org",
        "commons.wikimedia.org",
        "thumb.wikimedia.org",
        "upload.wikimedia.org",
        "api.listenbrainz.org",
        {
          "host": "$config:baseUrl",
          "rateLimit": {
            "perSecond": 1,
            "burst": 1
          }
        },
        "$config:artworkBaseUrl"
      ],
      "rateLimit": {
        "perSecond": 5,
        "burst": 5
      }
    },
    "kv": {
      "maxBytes": 67108864
    }
  },
  "config": {
    "server": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "baseUrl": {
            "type": "string",
            "format": "uri",
            "title": "MusicBrainz WS/2 base URL",
            "description": "Base URL of the MusicBrainz web service. Point it at a mirror to keep traffic off musicbrainz.org; a value without a trailing slash gets one.",
            "default": "https://musicbrainz.org/ws/2/"
          },
          "artworkBaseUrl": {
            "type": "string",
            "format": "uri",
            "title": "Cover Art Archive base URL",
            "description": "Base URL of the Cover Art Archive. Point it at a mirror to keep traffic off coverartarchive.org; a value without a trailing slash gets one.",
            "default": "https://coverartarchive.org"
          },
          "wikipediaLanguage": {
            "type": "string",
            "pattern": "^[a-z]{2,3}$",
            "title": "Wikipedia language",
            "description": "Language code of the Wikipedia edition artist biographies are read from, for example en, de or pt. An artist whose Wikidata item has no page in this edition falls back to the English one.",
            "default": "en"
          }
        }
      },
      "uiSchema": {
        "type": "VerticalLayout",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/baseUrl"
          },
          {
            "type": "Control",
            "scope": "#/properties/artworkBaseUrl"
          },
          {
            "type": "Control",
            "scope": "#/properties/wikipediaLanguage"
          }
        ]
      }
    },
    "user": null
  },
  "resources": {
    "memoryMb": 64,
    "callTimeoutMs": 30000,
    "maxInstances": 2
  }
}
